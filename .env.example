# Copy to .env (never commit it) or set these in your host's secret settings.
# Microsoft Foundry / Azure OpenAI, v1 API. Both host forms work:
#   https://<resource>.openai.azure.com/openai/v1
#   https://<resource>.services.ai.azure.com/openai/v1
MTG_AI_BASE_URL=
# Key-based auth (sent as the api-key header). Or use MTG_AI_BEARER_TOKEN for Entra ID
# (token scope https://ai.azure.com/.default, role "Cognitive Services OpenAI User").
MTG_AI_API_KEY=
MTG_AI_BEARER_TOKEN=
# Deployment name of a chat model that supports structured outputs (json_schema, strict).
MTG_AI_MODEL=
# Optional sampling temperature (omit for reasoning models that do not accept it)
MTG_AI_TEMPERATURE=
# Server bind (use HOST=0.0.0.0 in a container)
PORT=8000
HOST=127.0.0.1
